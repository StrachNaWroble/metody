let matrix_exp_fast m k =
let rec pot i m1 acc = 
    if i = 0 then acc else 
    if i mod 2 = 0 then pot (i/2) (matrix_mult m1 m1) acc else
    pot (i-1) m1 (matrix_mult acc m1)
  in pot k m matrix_id;; 

let fib_fast n =
    let x1, x2, x3, x4 = matrix_exp_fast (1, 1, 1, 0) n
    in x1;;

