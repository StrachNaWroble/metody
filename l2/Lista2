let rec fib n =
  if n = 0 then 0
  else if n = 1 then 1
  else (fib (n-1)) + (fib (n-2));;
  
let fib_iter n =
	if n == 0 then 0 else 
	let rec it i a b =
		if i = n-1 then (max a b)
		else if a > b then (it (i+1) a (a+b))
		else (it (i+1) (a+b) b)
	in it 0 0 1;;
		
		
