let matrix_mult m n =
let x1, x2, x3, x4 = m and y1, y2, y3, y4 = n
in (x1*y1+x2*y3, x1*y2+x2*y4, x3*y1+x4*y3, x3*y2+x4*y4);;

let matrix_id = (1, 0, 0, 1);;

let matrix_expt m k = 
    let rec it i copy = 
        if i = k-1 then copy
        else (it (i+1) (matrix_mult copy m)) 
    in it 0 m;;

let fib_matrix n = 
  let x1, x2, x3, x4 = matrix_expt (1, 1, 1, 0) n in
  x1;;


