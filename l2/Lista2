let select xs = 
if xs = [] then (0, []) else 

    let rec it lista mini = 
        match lista with 
        | [] -> mini
        | head :: tail -> if head < mini then it tail head
                          else it tail mini
    in let minimum = it xs (List.hd xs) in 

    let rec filtruj lista minimum acc check = 
        match lista with
        | [] -> (minimum, acc)
        | head :: tail -> 
                         if (head = minimum && check = 0)
                             then filtruj tail minimum acc 1
                         else filtruj tail minimum (head :: acc) check
    in filtruj xs minimum [] 0;;


let select_sort xs = 
    let rec sort lista acc = 
       match lista with 
       | [] -> acc
       | _ -> let (mini, rest) = select lista in 
                                sort rest (mini :: acc)
    in (List.rev (sort xs []));;


