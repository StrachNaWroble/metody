let split xs = 
  let polowa = ((List.length xs)/2) in 
    let rec it polowa lista l p = 
      match lista with
      | [] -> (l, p)
      | head :: tail -> if polowa > 0 then it (polowa-1) tail (head :: l) p
                        else it (polowa-1) tail l (head :: p)
    in it polowa xs [] [];;


let merge l p =
  let rec it lewa prawa acc = 
    if (lewa = [] && prawa = []) then acc
    else if lewa = [] then it lewa (List.tl prawa) ((List.hd prawa) :: acc) 
    else if prawa = [] then it (List.tl lewa) prawa ((List.hd lewa) :: acc)
    else 
      let h_l = (List.hd lewa) and h_p = (List.hd prawa) in
        if h_l < h_p then it (List.tl lewa) prawa (h_l :: acc)
        else it lewa (List.tl prawa) (h_p :: acc)
  in (List.rev (it l p []) );;


let rec merge_sort xs =
   match xs with
   | [] -> []
   | [x] -> [x]
   | _ -> let (l, p) = split xs in
          let l_res = merge_sort l and p_res = merge_sort p
            in merge l_res p_res;; 







