expr = {1; 9; "+"; 2; 3; "*"; "+"};
n = 7;

arr = {};
wsk = 0;

for (i=0; i < n; i = i+1) 
{
    x = expr[i];
    if (x == "+") 
    {
        b = arr[wsk-1];
        a = arr[wsk-2];
        arr[wsk-2] = a + b;
        wsk = wsk-1;
    } 
    else 
    {
        if (x == "*")
        {
            b = arr[wsk-1];
            a = arr[wsk-2];
            arr[wsk-2] = a * b;
            wsk = wsk-1;
        }
        else
        {
            arr[wsk] = x;
            wsk = wsk+1;
        }
    }    
}

print(arr[0]);
print("\n");